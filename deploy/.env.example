# Copy to deploy/.env and fill in. Generate secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=
SIGNING_KEY=
WORKER_TOKEN=
# Operator endpoints (GET /v1/admin/usage-report); at least 16 characters. Empty = off.
ADMIN_TOKEN=
PORT=8000
WORKERS=1
WORKER_MEMORY=6g
WORKER_CACHE_GB=20
MODELS_DIR=./models
# The preset prompt step (narrative -> English prompt) uses Claude when set; without it, a template.
# Only the API reads it (never workers or clients).
ANTHROPIC_API_KEY=
PROMPT_MODEL=claude-haiku-5-5
# The output classifier's labels that hold a preset result (score at or above the threshold).
MODERATION_THRESHOLDS=nsfw=0.5
# Interactive presets run only on workers reporting one of these regions (WORKER_REGION); empty =
# anywhere. Production: INTERACTIVE_REGIONS=eu with WORKER_REGION=eu on EU workers (docs/PRIVACY.md).
INTERACTIVE_REGIONS=
WORKER_REGION=
# On-demand GPU workers for sessions (docs/ARCHITECTURE.md, "Sessions and on-demand GPUs"). Empty =
# none (GPU workers started by hand). The API key stays with the API.
CAPACITY_PROVIDER=
CAPACITY_MAX_PODS=3
CAPACITY_DAILY_BUDGET_USD=10
CAPACITY_MONTHLY_BUDGET_USD=
RUNPOD_API_KEY=
RUNPOD_IMAGE=ghcr.io/sberkan09/neuracraft-worker-gpu:latest
RUNPOD_GPU_TYPES=NVIDIA RTX A5000,NVIDIA RTX A4000,NVIDIA GeForce RTX 4090
RUNPOD_CLOUD=SECURE
RUNPOD_DATA_CENTERS=EU-RO-1
# Tried without the network volume when RUNPOD_DATA_CENTERS have no free GPU (comma-separated).
RUNPOD_FALLBACK_DATA_CENTERS=
RUNPOD_NETWORK_VOLUME_ID=
RUNPOD_WORKER_API_URL=
RUNPOD_WORKER_ENV=KEEP_MODELS=8,INTERACTIVE_ONLY=1,WARMUP=1,WORKER_REGION=eu
# Sign-in codes for partner apps' end users (issue #48, docs/partners/gm-cebi.md). brevo: Brevo's API
# (BREVO_API_KEY, a sender verified in Brevo); log: the code goes to the API's log (development only);
# empty: no end-user sign-in. Lifetimes: END_USER_ACCESS_MINUTES (60), END_USER_REFRESH_DAYS (90),
# END_USER_REFRESH_GRACE_SECONDS (60: a rotated refresh token may come back this long, at most 600),
# SIGN_IN_CODE_MINUTES (10); limits: SIGN_IN_CODES_PER_HOUR (5 per address), SIGN_IN_STARTS_PER_IP_PER_HOUR (20).
MAIL_PROVIDER=
MAIL_FROM=NeuraCraft <no-reply@neuracraft.example>
BREVO_API_KEY=
# How long preset inputs (sketches, colour hints) and narratives are kept, replacing each preset's own
# value (24 hours for sketch_to_scene). Empty: the presets' values.
INPUT_RETENTION_HOURS=
