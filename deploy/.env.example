# Copy to deploy/.env and fill in. Generate secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=
SIGNING_KEY=
WORKER_TOKEN=
PORT=8000
WORKERS=1
WORKER_MEMORY=6g
WORKER_CACHE_GB=20
MODELS_DIR=./models
# The preset prompt step (narrative -> English prompt) uses Claude when set; without it, a template.
# Only the API reads it (never workers or clients).
ANTHROPIC_API_KEY=
PROMPT_MODEL=claude-haiku-5-5
