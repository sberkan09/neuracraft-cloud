# Production settings (not secret; committed). deploy.sh joins this file with internal.env (made on the
# server once: database password, signing key, worker token) and secrets.env (GitHub secrets).
SITE_DOMAIN=api.neuracraft.app

# Beta: one GPU at most, 15 USD a month, given back quickly.
CAPACITY_PROVIDER=runpod
CAPACITY_MAX_PODS=1
CAPACITY_DAILY_BUDGET_USD=5
CAPACITY_MONTHLY_BUDGET_USD=15
CAPACITY_GRACE_MINUTES=5
SESSION_IDLE_MINUTES=20
# Tried in order: the verified Ampere / Ada cards first, then Blackwell (runs, but 5 engine GPU tests
# fail there, as 4 do on the 4090: NeuraCraft #79). The worker image runs on Ampere (A-series, A40), Ada
# (40xx, RTX 2000 Ada) and Blackwell (50xx, RTX PRO); the RTX 2000 Ada is the slowest.
RUNPOD_GPU_TYPES=NVIDIA RTX A5000,NVIDIA RTX A4000,NVIDIA A40,NVIDIA GeForce RTX 4090,NVIDIA RTX PRO 4000 Blackwell,NVIDIA RTX PRO 4500 Blackwell,NVIDIA RTX 2000 Ada Generation,NVIDIA GeForce RTX 5090
RUNPOD_CLOUD=SECURE
RUNPOD_DATA_CENTERS=EU-RO-1
# A network volume in RUNPOD_DATA_CENTERS for the pods' model cache (empty: each pod downloads them).
RUNPOD_NETWORK_VOLUME_ID=li0w5nkx96
# When EU-RO-1 has none of those free: other European data centres, without the volume.
RUNPOD_FALLBACK_DATA_CENTERS=EU-NL-1,EU-CZ-1,EU-SE-1,EU-FR-1,EUR-IS-1,EUR-IS-2,EUR-IS-3,EUR-IS-4,EUR-IS-5,EUR-NO-1,EUR-NO-2
RUNPOD_WORKER_ENV=KEEP_MODELS=8,INTERACTIVE_ONLY=1,WARMUP=1,WORKER_REGION=eu
INTERACTIVE_REGIONS=eu

PROMPT_MODEL=claude-haiku-5-5

# Closed beta (docs/PRIVACY.md): sketches, colour hints and narratives are kept 7 days instead of 24
# hours, to look at testers' results (cli/job-export.js). Remove before a public release.
INPUT_RETENTION_HOURS=168

# Sign-in codes for partner apps' end users (issue #48), sent through Brevo (EU) from a verified sender
# on the domain. The API key is the BREVO_API_KEY GitHub secret.
MAIL_PROVIDER=brevo
MAIL_FROM=NeuraCraft <no-reply@neuracraft.app>
MODERATION_THRESHOLDS=nsfw=0.5
